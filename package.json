{
  "name": "india-accountability-monitor",
  "version": "3.0.0",
  "private": true,
  "description": "Source-linked India accountability research dashboard",
  "scripts": {
    "prepare:data": "tsx scripts/prepare-data.ts",
    "dev": "npm run prepare:data && vite",
    "validate": "python3 scripts/validate.py && npm run prepare:data && tsc --noEmit",
    "build": "npm run validate && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "test:unit": "vitest run tests/unit",
    "test:browser": "playwright test",
    "test": "npm run validate && npm run test:unit && npm run test:browser",
    "format": "prettier --write src content data/*.json scripts/*.ts tests *.json *.ts",
    "research:recompute": "npm run prepare:data"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "csv-parse": "6.2.1",
    "prettier": "3.6.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  }
}
